---
import Lever from "./lever.gif";
import LeverOff from "./leverOff.webp";
import LeverRed from "./leverRed.webp";
import Glow from "./glow.webp";
import LeverOn from "./leverOn.webp";
---

<style>
  .screen {
    top: 0px;
    left: 0px;
    width: 1000vw;
    height: 1000vh;
    background-color: black;
    position: fixed;
    opacity: 89%;
    z-index: 1000;
  }

  .lever {
    z-index: 1001;
    justify-self: right;
    position: absolute;
    margin-top: 10px;
    right: 52px;
    z-index: 1001;
    width: 160px;
    image-rendering: pixelated;
  }

  .glow {
    image-rendering: pixelated;
    position: absolute;
    justify-self: right;
    opacity: 0%;
    right: -95px;
    margin-top: -140px;
    pointer-events: none;
    width: 80%;
  }

  .placement {
    justify-content: right;
    justify-content: right;
  }

  .text {
    color: white;
    text-align: center;
    font-size: 95%;
    line-height: 75%;
  }

  .center {
    width: 100vw;
    /* height: 100vh; */
    margin-top: 400px;
    justify-content: center;
    justify-items: center;
    align-content: center;
    align-items: center;
    display: flex;
    flex-direction: column;
  }

  .buttons {
    display: flex;
    gap: 10px;
    image-rendering: pixelated;
  }
</style>

<script type="text/javascript" src="/libgif.js"></script>

<script type="module">
  import { powerState } from "/stores/app.js";

  let lever = document.getElementById("lever");
  let leverRed = document.getElementById("leverRed");
  let glow1 = document.getElementById("glow1");
  let glow2 = document.getElementById("glow2");
  let contain = document.getElementById("contain");
  let screen = document.getElementById("screen");

  let canvasParent = null;
  let continueBlinking = true;

  // Activate
  let gif = new SuperGif({ gif: lever, draw_while_loading: true, show_progress_bar: false, max_width: 160, loop_mode: false });
  let loaded = false;
  let clicked = false;

  gif.load(() => {
    loaded = true;
    canvasParent = gif.get_canvas().parentElement;
    leverRed.style.opacity = "100%";
    blinkRed();
    if (clicked) {
      pullLever();
    }
  });

  contain.addEventListener("mousedown", () => {
    if (!clicked) {
      clicked = true;
      if (loaded) {
        pullLever();
      }
    }
  });

  let counter = 0;

  function pullLever() {
    canvasParent.style.opacity = "100%";
    leverRed.remove();
    glow1.remove();
    glow2.remove();
    continueBlinking = false;
    nextStep();
  }

  function nextStep() {
    counter += 1;
    if (counter == 31) {
      screen.style.opacity = "40%";
      powerState.powerChangeReactions.map((fn) => fn(0.5));
    }
    if (counter == 41) {
      screen.style.opacity = "89%";
      powerState.powerChangeReactions.map((fn) => fn(0));
    }
    if (counter == 46) {
      screen.style.opacity = "20%";
      powerState.powerChangeReactions.map((fn) => fn(0.8));
    }
    if (counter == 48) {
      screen.style.opacity = "89%";
      powerState.powerChangeReactions.map((fn) => fn(0));
    }
    if (counter == 51) {
      screen.style.opacity = "0%";
      powerState.powerChangeReactions.map((fn) => fn(1));
    }
    if (counter == 57) {
      screen.style.opacity = "89%";
      powerState.powerChangeReactions.map((fn) => fn(0));
    }
    gif.move_relative(1);
    if (counter < 60) {
      setTimeout(nextStep, 30);
    } else {
      screen.remove();
      powerState.enabled = true;
      powerState.powerChangeReactions.map((fn) => fn(1));
    }
  }
  // Blink
  let blink = true;

  function blinkRed() {
    if (!continueBlinking) {
      return;
    }
    blink = !blink;
    if (blink) {
      glow1.style.opacity = "0%";
      glow2.style.opacity = "0%";
      canvasParent.style.opacity = "100%";
      setTimeout(blinkRed, 1250);
    } else {
      glow1.style.opacity = "10%";
      glow2.style.opacity = "10%";
      canvasParent.style.opacity = "0%";
      setTimeout(blinkRed, 400);
    }
  }

  let swap = false;
  let button2 = document.getElementById("button2");
  let button3 = document.getElementById("button3");
  blinkButtons();
  function blinkButtons() {
    swap = !swap;

    if (swap) {
      button2.src = "/buttons/NoAiArt2.webp"
      button3.src = "/buttons/ViewWithComputer2.webp"
    } else {
      button2.src = "/buttons/NoAiArt1.webp"
      button3.src = "/buttons/ViewWithComputer1.webp"
    }

    setTimeout(blinkButtons, 1500);
  }
</script>

<div class="placement">
  <div class="screen" id="screen">
    <div class="center">
      <p class="text">
      <b>hopeflea.net</b>
      <br />
      <br />
      <br />
        The recommanded experience is on a 1920x1080 desktop monitor with firefox.
      <br />
      <br />
        This website may contains unsettling imagery. Viewer discrtion is advised.
      <br />
      <br />
      </p>
      <div class="buttons">
        <img id="button1" src="/buttons/Firefox.webp"/>
        <img id="button2" src="/buttons/NoAiArt1.webp"/>
        <img id="button3" src="/buttons/ViewWithComputer1.webp"/>
      </div>
    </div>
  </div>
  <img class="glow" id="glow1" src={Glow.src}/>
  <img class="lever" id="leverRed" style="opacity: 0;" src={LeverRed.src}/>
  <img class="glow" style="z-index: 1002;" id="glow2" src={Glow.src}/>
  <div id="contain" class="lever">
    <img class="lever" id="lever" src={LeverOff.src} rel:animated_src={Lever.src} rel:auto_play="0"/>
  </div>
  <!-- <img class="lever" id="leverOff" src={LeverOff.src} style="opacity: 0%;" /> -->
</div>
