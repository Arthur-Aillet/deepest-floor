---
import loadingGif from "./hopeflea-loading.gif";
import barGif from "./bar-loading.gif";
import depthsGif from "./depths.gif";
---

<style>
    .layout {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        flex-direction: column;
        gap: 50px;
    }

    @keyframes appearing {
        0% {
            opacity: 0%;
        }
        5% {
            opacity: 100%;
        }
        95% {
            opacity: 100%;
        }
        100% {
            opacity: 0%;
        }
    }

    .text {
        animation: appearing 7.62s linear;
    }
    .bar {
        opacity: 0%;
        height: 35px;
        animation-fill-mode: forwards;
    }
    .depths {
        width: 915px;
        margin-bottom: 100px;
    }
</style>

<script define:vars={{barGif, depthsGif}}>
    const barDuration = 5110;
    const textDuration = 7620;
    const sleepDuration = 1000;
    const depthsDuration = 2200;
    const gifSpawn = (textDuration - barDuration) / 2;

    setTimeout(() => {
        let bar = document.getElementById("bar");
        if (!bar)
            return;
        bar.src = barGif.src;
        bar.style["animation"] = "appearing 5.11s linear";
    }, gifSpawn);
    setTimeout(() => {
        let bar = document.getElementById("bar");
        if (!bar)
            return;
        bar.src = "";
    }, gifSpawn + barDuration);
    setTimeout(() => {
        let text = document.getElementById("text");
        if (!text)
            return;
        text.src = "";
    }, textDuration);
    setTimeout(() => {
        let layout = document.getElementById("layout");
        if (!layout)
            return;
        layout.style["justifyContent"] = "end";
        let depths = document.getElementById("depths");
        if (!depths)
            return;
        depths.style["animation"] = "appearing 2.19s linear";
        depths.src = depthsGif.src;
    }, sleepDuration + textDuration);
    setTimeout(() => {
        let depths = document.getElementById("depths");
        if (!depths)
            return;
        depths.remove();
    }, sleepDuration + textDuration + depthsDuration);
</script>

<div class="layout" id="layout">
    <img src={loadingGif.src} class="text" id="text" />
    <img class="bar" id="bar" />
    <img id="depths" class="depths" />
</div>