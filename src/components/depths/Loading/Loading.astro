---
import loadingGif from "./hopeflea-loading.gif";
import barGif from "./bar-loading.gif";
---

<style>
    .layout {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 100%;
        flex-direction: column;
        gap: 50px;
    }

    @keyframes appearing {
        0% {
            opacity: 0%;
        }
        5% {
            opacity: 100%;
        }
        95% {
            opacity: 100%;
        }
        100% {
            opacity: 0%;
        }
    }

    .gif {
        animation: appearing 7.62s linear;
    }
    .bar {
        opacity: 0%;
        height: 35px;
        animation-fill-mode: forwards;
    }
</style>

<script define:vars={{barGif}}>
    const gifDuration = 5110;
    const totalDuration = 7620;
    const gifSpawn = (totalDuration - gifDuration) / 2;

    setTimeout(() => {
        let bar = document.getElementById("bar");
        bar.src = barGif.src;
        bar.style["animation"] = "appearing 5.11s linear";
    }, gifSpawn);
    setTimeout(() => {
        let bar = document.getElementById("bar");
        bar.src = "";
    }, gifSpawn + gifDuration);
</script>

<div class="layout">
    <img src={loadingGif.src} class="gif" />
    <img class="bar" id="bar" />
</div>